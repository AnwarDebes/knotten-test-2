{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knotten/energy_contract",
  "title": "Knotten energy data contract",
  "description": "What the energy/technical group returns per plot, per system and per meter. IDs follow the platform spine field -> plot -> building -> system -> meter -> reading. Every value carries a source and a date so the website can show provenance.",
  "type": "object",
  "required": ["field", "plots"],
  "properties": {
    "field": {
      "type": "object",
      "required": ["id", "assumptions_version", "updated"],
      "properties": {
        "id": {"const": "knotten"},
        "assumptions_version": {"type": "string", "examples": ["2026-09-A"]},
        "updated": {"type": "string", "format": "date"},
        "community": {
          "type": "object",
          "description": "Field-level shared systems",
          "properties": {
            "energy_hub": {"$ref": "#/$defs/system"},
            "shared_battery_kwh": {"type": "number"},
            "shared_pv_kwp": {"type": "number"},
            "seasonal_storage": {"$ref": "#/$defs/system"},
            "islanding_hours_at_winter_load": {"type": "number", "description": "Robustness: hours the field runs on its own storage in a January outage"},
            "annual_import_kwh": {"type": "number"},
            "annual_export_kwh": {"type": "number"},
            "co2_avoided_kg_per_year": {"type": "number"}
          }
        },
        "investor": {
          "type": "object",
          "description": "Business figures the investor section renders; each is an estimate object with a source",
          "properties": {
            "energy_saving_pct_vs_tek17": {"$ref": "#/$defs/estimate"},
            "opex_saving_nok_per_home_year": {"$ref": "#/$defs/estimate"},
            "capex_premium_nok_per_home": {"$ref": "#/$defs/estimate"},
            "payback_years": {"$ref": "#/$defs/estimate"},
            "scalability_note": {"type": "string"},
            "esg": {"type": "object", "additionalProperties": {"$ref": "#/$defs/estimate"}}
          }
        }
      }
    },
    "plots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plot_id"],
        "properties": {
          "plot_id": {"type": "string", "pattern": "^plot-[0-9]{2}$", "description": "must match data/plots.json"},
          "building_class": {"type": "string", "enum": ["TEK17", "lavenergi", "passivhus", "plusshus"]},
          "heated_floor_area_m2": {"type": "number"},
          "net_energy_demand_kwh_m2_year": {"$ref": "#/$defs/estimate"},
          "space_heating_kwh_year": {"$ref": "#/$defs/estimate"},
          "pv": {
            "type": "object",
            "properties": {
              "kwp": {"type": "number"},
              "roof_pitch_used": {"type": "string", "enum": ["south", "both", "facade", "none"]},
              "annual_yield_kwh": {"$ref": "#/$defs/estimate"},
              "yield_basis": {"type": "string", "description": "e.g. 'PVGIS with horizon_deg_by_bearing from plots.json'"}
            }
          },
          "battery_kwh": {"type": "number"},
          "heat_source": {"type": "string", "enum": ["air_water_hp", "ground_source_hp", "district", "direct_electric", "other"]},
          "v2h_capable": {"type": "boolean"},
          "self_sufficiency_pct": {"$ref": "#/$defs/estimate"},
          "annual_cost_nok": {"$ref": "#/$defs/estimate"},
          "systems": {"type": "array", "items": {"$ref": "#/$defs/system"}}
        }
      }
    },
    "existing_buildings": {
      "type": "array",
      "description": "The office and the house: measured history that anchors the theory",
      "items": {
        "type": "object",
        "required": ["building_id", "meters"],
        "properties": {
          "building_id": {"type": "string", "examples": ["existing-office", "existing-house"]},
          "heated_floor_area_m2": {"type": "number"},
          "meters": {"type": "array", "items": {"$ref": "#/$defs/meter"}}
        }
      }
    }
  },
  "$defs": {
    "estimate": {
      "type": "object",
      "required": ["value", "unit", "source", "date"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string"},
        "low": {"type": "number"},
        "high": {"type": "number"},
        "source": {"type": "string", "description": "method, tool or document"},
        "date": {"type": "string", "format": "date"},
        "note": {"type": "string"}
      }
    },
    "system": {
      "type": "object",
      "required": ["system_id", "type"],
      "properties": {
        "system_id": {"type": "string", "description": "<plot_id>/<building>/<type>-<n>, e.g. plot-07/a/pv-1"},
        "type": {"type": "string", "enum": ["pv", "battery", "heat_pump", "ev_charger", "hub", "wind", "geothermal", "sand_storage", "inverter", "other"]},
        "rated_kw": {"type": "number"},
        "capacity_kwh": {"type": "number"},
        "vendor_model": {"type": "string"},
        "meter_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "meter": {
      "type": "object",
      "required": ["meter_id", "measures", "unit", "resolution"],
      "properties": {
        "meter_id": {"type": "string", "description": "Elhub metering point id or a local id"},
        "measures": {"type": "string", "enum": ["import", "export", "production", "consumption", "heat", "temperature", "soc"]},
        "unit": {"type": "string", "examples": ["kWh", "kW", "degC", "%"]},
        "resolution": {"type": "string", "enum": ["PT15M", "PT1H", "P1D", "P1M"]},
        "readings_file": {"type": "string", "description": "CSV: timestamp_iso8601,value — UTC"},
        "period": {"type": "object", "properties": {"from": {"type": "string", "format": "date"}, "to": {"type": "string", "format": "date"}}}
      }
    }
  }
}
